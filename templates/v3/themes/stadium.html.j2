{% extends "base.html.j2" %}
{% from "macros.j2" import mark, wordmark with context %}
{% block css %}
body{background:var(--ink);font-family:BC,sans-serif}
#bg,#photo{position:absolute;inset:0;width:1080px;height:1920px}
#photo{height:1150px;object-fit:cover;object-position:center 55%;display:none;filter:saturate(1.15) contrast(1.08) brightness(.82);-webkit-mask-image:linear-gradient(180deg,#000 0%,#000 55%,transparent 100%);mask-image:linear-gradient(180deg,#000 0%,#000 55%,transparent 100%)}
.grade{position:absolute;inset:0;height:1150px;display:none;background:linear-gradient(90deg,var(--a) 0%,transparent 45%,transparent 55%,var(--b) 100%);opacity:.35;mix-blend-mode:color}
.shade{position:absolute;inset:0;background:
  linear-gradient(180deg,rgba(11,14,20,.55) 0%,rgba(11,14,20,.05) 18%,rgba(11,14,20,.10) 34%,rgba(11,14,20,.78) 46%,rgba(11,14,20,.93) 70%,var(--ink) 100%)}
.wrap{position:absolute;inset:0;padding:0 44px}
.top{display:flex;justify-content:space-between;align-items:center;padding-top:34px}
.wmt{font-family:Anton;font-size:54px;font-style:italic;letter-spacing:1px;text-shadow:0 4px 18px rgba(0,0,0,.7)}
.wmt span{padding-right:14px;background:linear-gradient(180deg,var(--lime-hi),var(--gold) 45%,var(--gold2));-webkit-background-clip:text;color:transparent}
.desk{font-weight:900;font-size:20px;letter-spacing:4px;padding:10px 16px;border:2px solid rgba(184,235,107,.8);color:var(--gold);background:rgba(0,0,0,.45);transform:skewX(-10deg)}
.hero{margin-top:96px;text-align:center}
.live{display:inline-flex;align-items:center;gap:12px;background:#e11d2e;padding:10px 26px;font-weight:900;font-size:28px;letter-spacing:4px;transform:skewX(-12deg);box-shadow:0 0 40px rgba(225,29,46,.7)}
.live i{width:14px;height:14px;border-radius:50%;background:#fff;box-shadow:0 0 12px #fff}
h1{font-family:Anton;font-size:166px;line-height:.9;margin-top:22px;letter-spacing:2px;text-transform:uppercase;
  background:linear-gradient(180deg,#ffffff 0%,#f2ffd9 38%,var(--gold) 62%,var(--gold2) 100%);-webkit-background-clip:text;color:transparent;
  filter:drop-shadow(0 6px 0 rgba(0,0,0,.85)) drop-shadow(0 0 38px rgba(184,235,107,.55))}
.match{margin-top:18px;font-weight:900;font-size:40px;letter-spacing:3px;text-shadow:0 3px 12px #000}
.pills{margin-top:18px;display:flex;justify-content:center;gap:12px}
.pills span{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.35);backdrop-filter:blur(6px);padding:9px 20px;font-weight:800;font-size:26px;letter-spacing:2px;border-radius:40px}
.pills b{color:var(--gold)}
.vs{position:relative;margin-top:34px;height:350px;display:flex;gap:0}
.p{position:relative;flex:1;overflow:hidden;padding:26px 30px}
.p.l{background:linear-gradient(135deg,var(--a) 0%,rgba(0,0,0,.6) 100%);clip-path:polygon(0 0,100% 0,88% 100%,0 100%);border-left:6px solid var(--a2)}
.p.r{background:linear-gradient(225deg,var(--b) 0%,rgba(0,0,0,.6) 100%);clip-path:polygon(12% 0,100% 0,100% 100%,0 100%);text-align:right;border-right:6px solid var(--b2);margin-left:-60px}
.ghost{position:absolute;font-family:Anton;font-size:300px;line-height:1;opacity:.13;top:-20px}
.p.l .ghost{right:40px}.p.r .ghost{left:40px}
.tag{font-weight:900;font-size:22px;letter-spacing:4px;opacity:.9}
.nm{font-family:Anton;font-size:72px;line-height:.92;margin:10px 0 14px;text-shadow:0 4px 18px rgba(0,0,0,.6)}
.big{display:inline-block;font-weight:900;font-size:36px;color:#111;background:linear-gradient(180deg,var(--lime-hi),var(--gold));padding:4px 14px;transform:skewX(-10deg)}
.sm{font-weight:600;font-size:23px;margin-top:10px;line-height:1.25;opacity:.95}
.vsb{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:132px;height:132px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#3a3a3a,#000 70%);border:5px solid var(--gold);display:grid;place-items:center;
  font-family:Anton;font-size:62px;color:var(--gold);box-shadow:0 0 50px rgba(184,235,107,.8),inset 0 0 20px rgba(184,235,107,.4);z-index:3}
.nug{margin-top:22px;display:flex;align-items:center;gap:28px;padding:20px 28px;border-radius:18px;
  background:linear-gradient(100deg,rgba(184,235,107,.22),rgba(127,207,58,.06) 60%,rgba(0,0,0,.2));border:2px solid rgba(184,235,107,.75);box-shadow:0 0 60px rgba(184,235,107,.25)}
.ring{position:relative;width:170px;height:170px;flex:none}
.ring svg{position:absolute;inset:0}
.ring .n{position:absolute;inset:0;display:grid;place-items:center;font-family:Anton;font-size:76px;color:var(--gold);text-shadow:0 0 24px rgba(184,235,107,.7)}
.nt{font-weight:900;font-size:22px;letter-spacing:4px;color:var(--gold)}
.nh{font-family:Anton;font-size:62px;line-height:1;margin:6px 0 10px}
.nx{font-weight:600;font-size:26px;line-height:1.3}
.grid{margin-top:16px;display:grid;grid-template-columns:1fr 1fr;gap:14px}
.c{position:relative;padding:16px 20px 14px;border-radius:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);overflow:hidden}
.c:before{content:"";position:absolute;left:0;top:0;right:0;height:5px;background:var(--acc,var(--gold))}
.c .t{font-weight:900;font-size:19px;letter-spacing:3px;color:var(--acc2,var(--gold))}
.c .h{font-family:Anton;font-size:38px;line-height:1;margin:8px 0}
.c .d{font-weight:600;font-size:22px;line-height:1.3;opacity:.92}
.c .e{position:absolute;right:14px;top:12px;font-size:34px}
.way{display:none;margin-top:18px;font-weight:600;font-size:19px;line-height:1.35;opacity:.75;text-align:center}
.foot{position:absolute;left:0;right:0;bottom:0;padding:18px 44px 20px;text-align:center;background:linear-gradient(180deg,rgba(11,14,20,0),var(--ink) 30%)}
.cta{display:flex;align-items:center;justify-content:center;gap:16px;height:96px;border-radius:60px;
  background:linear-gradient(180deg,var(--lime-hi),var(--gold) 45%,var(--gold2));color:var(--ink);font-family:Anton;font-size:50px;letter-spacing:1px;
  box-shadow:0 0 60px rgba(184,235,107,.55),0 8px 0 #3f7a12}
.url{margin-top:12px;font-family:Anton;font-size:44px;letter-spacing:3px}
.fine{margin-top:6px;font-weight:600;font-size:16px;opacity:.55}
.credit{position:absolute;right:44px;top:118px;font-weight:600;font-size:15px;opacity:.75;display:none;text-shadow:0 1px 4px #000}
.wm .logo{filter:drop-shadow(0 0 16px rgba(122,222,255,.45));margin:-14px 0}
.wmt b{font-weight:400}
h1 .fit{overflow:visible}
.nm .fit{max-width:430px}
.p.r .nm .fit{margin-left:auto}
.nug>div:last-child{min-width:0;flex:1}
.ring svg{position:absolute;inset:0}
{% endblock %}
{% block body %}<canvas id="bg" width="1080" height="1920"></canvas>
{% if d.venuePhoto %}<img id="photo" alt="" src="{{ d.venuePhoto }}" style="display:block"><div class="grade" style="display:block"></div>{% endif %}
<div class="shade"></div>
<div class="wrap content">
  <div class="top">{{ wordmark(100) }}<div class="desk">PLAYER INTELLIGENCE DESK</div></div>
  <div class="hero">
    <div class="live"><i></i>{{ d.live }}</div>
    <h1><span class="fit">{{ d.hook[0] }}</span><span class="fit">{{ d.hook[1] }}</span></h1>
    <div class="match">{{ d.match }}</div>
    <div class="pills"><span><b>{{ d.time_label }}</b> {{ d.time }}</span><span>{{ d.network }}</span><span>{{ d.venue }}</span></div>
  </div>
  <div class="vs">
    {% for p,side in [(d.p1,'l'),(d.p2,'r')] %}<div class="p {{ side }}"><div class="ghost">{{ p.t.abbr }}</div>
      <div class="tag">{{ p.t.name|upper }} · {{ p.pos }}</div>
      <div class="nm"><span class="fit">{{ p.first }}</span><span class="fit">{{ p.last }}</span></div>
      <div class="big">{{ p.stat }}</div>
      <div class="sm">{{ p.sub[0] }}<br>{{ p.sub[1] }}</div>
    </div>{% if side=='l' %}<div class="vsb">VS</div>{% endif %}{% endfor %}
  </div>
  <div class="nug">
    <div class="ring">{{ ring(d.nugget.hit, d.nugget.total, b.lime, 'rgba(255,255,255,.18)') }}<div class="n" style="font-size:{{ 76 if d.nugget.frac|length<4 else 52 }}px">{{ d.nugget.frac }}</div></div>
    <div><div class="nt">📊 FROM THE {{ b.sheet }}</div><div class="nh fit">{{ d.nugget.head }}</div><div class="nx">{{ d.nugget.text }}</div></div>
  </div>
  <div class="grid">
    {% set accs=[('var(--a2)','#ffb066'),('var(--b2)','#a6e36b'),('#a77bff','#c9a8ff'),('#e11d2e','#ff5a66')] %}
    {% for n in d.notes %}<div class="c" style="--acc:{{ accs[loop.index0][0] }};--acc2:{{ accs[loop.index0][1] }}"><div class="e">{{ n.e }}</div><div class="t">{{ n.t }}</div><div class="h fit">{{ n.h }}</div><div class="d">{{ n.d }}</div></div>{% endfor %}
  </div>
</div>
{% if d.photoCredit %}<div class="credit" style="display:block">{{ d.photoCredit }}</div>{% endif %}
<div class="foot"><div class="cta">{{ b.cta }}</div><div class="url">{{ b.url }}</div><div class="fine">{{ b.fine }}</div></div>{% endblock %}
{% block js %}drawStadium();
function drawStadium(){
  const cv=document.getElementById('bg'),x=cv.getContext('2d'),W=1080,H=1920;
  let sd={{ d.seed or 7 }};const rnd=()=>((sd=(sd*16807)%2147483647)/2147483647);
  // sky
  let g=x.createLinearGradient(0,0,0,H);g.addColorStop(0,'#050a1c');g.addColorStop(.35,'#0b1530');g.addColorStop(.6,'#050811');g.addColorStop(1,'#02040a');
  x.fillStyle=g;x.fillRect(0,0,W,H);
  const cx=W/2, horizon=330;
  // stadium bowl tiers (crowd)
  const tiers=[[1500,520,380,'#0d1426'],[1320,450,300,'#111a30'],[1160,390,235,'#141f38']];
  tiers.forEach(([rw,rh,yo,col],ti)=>{
    x.save();x.beginPath();x.ellipse(cx,horizon+yo,rw/1.5,rh/1.4,0,Math.PI,2*Math.PI);x.fillStyle=col;x.fill();x.clip();
    for(let i=0;i<9000;i++){const px=rnd()*W,py=horizon+yo-rh/1.4+rnd()*rh/1.4;
      const t=rnd();x.fillStyle=t<.04?'rgba(255,255,255,.95)':t<.5?`hsla(${'{{ d.sport }}'==='football'?200:210},20%,${18+rnd()*30}%,.9)`:(t<.75?"{{ d.away.color }}":"{{ d.home.color }}");
      x.globalAlpha=t<.04?1:.55;x.fillRect(px,py,2+rnd()*2,2+rnd()*2);}
    x.restore();
    // tier rim
    x.globalAlpha=1;x.strokeStyle='rgba(255,255,255,.12)';x.lineWidth=3;x.beginPath();x.ellipse(cx,horizon+yo,rw/1.5,rh/1.4,0,Math.PI,2*Math.PI);x.stroke();
  });
  x.globalAlpha=1;
  // field in perspective
  const fy=horizon+150, fb=880;
  x.save();x.beginPath();x.moveTo(cx-300,fy);x.lineTo(cx+300,fy);x.lineTo(cx+900,fb);x.lineTo(cx-900,fb);x.closePath();
  g=x.createLinearGradient(0,fy,0,fb);g.addColorStop(0,'#145c2a');g.addColorStop(1,'#0a3a1a');x.fillStyle=g;x.fill();x.clip();
  const lerp=(a,b,t)=>a+(b-a)*t;
  if('{{ d.sport }}'==='football'||'{{ d.sport }}'==='baseball'){
    for(let i=0;i<14;i++){const t0=Math.pow(i/14,1.6),t1=Math.pow((i+1)/14,1.6);x.fillStyle=i%2?'rgba(255,255,255,.04)':'rgba(0,0,0,.06)';
      const y0=lerp(fy,fb,t0),y1=lerp(fy,fb,t1),w0=lerp(300,900,t0),w1=lerp(300,900,t1);
      x.beginPath();x.moveTo(cx-w0,y0);x.lineTo(cx+w0,y0);x.lineTo(cx+w1,y1);x.lineTo(cx-w1,y1);x.fill();}
  }
  if('{{ d.sport }}'==='football'){
    x.strokeStyle='rgba(255,255,255,.55)';
    for(let i=0;i<=10;i++){const t=Math.pow(i/10,1.6),y=lerp(fy,fb,t),w=lerp(260,820,t);x.lineWidth=lerp(1.5,5,t);x.beginPath();x.moveTo(cx-w,y);x.lineTo(cx+w,y);x.stroke();}
    // end zone tints
    x.fillStyle="{{ d.home.color }}";x.globalAlpha=.55;x.beginPath();x.moveTo(cx-300,fy);x.lineTo(cx+300,fy);x.lineTo(cx+330,fy+40);x.lineTo(cx-330,fy+40);x.fill();x.globalAlpha=1;
  } else if('{{ d.sport }}'==='baseball'){
    x.fillStyle='#8a5a32';x.beginPath();x.moveTo(cx,fy+120);x.lineTo(cx+230,fy+330);x.lineTo(cx,fb-60);x.lineTo(cx-230,fy+330);x.closePath();x.fill();
    x.fillStyle='#145c2a';x.beginPath();x.moveTo(cx,fy+175);x.lineTo(cx+150,fy+325);x.lineTo(cx,fb-140);x.lineTo(cx-150,fy+325);x.closePath();x.fill();
    x.fillStyle='#fff';[[cx,fy+120],[cx+230,fy+330],[cx-230,fy+330]].forEach(([a,b])=>x.fillRect(a-8,b-8,16,16));
  } else {
    x.fillStyle='{{ d.sport }}'==='hockey'?'#dfe9f2':'#b98a55';x.fillRect(0,fy,W,fb-fy);
    x.strokeStyle='{{ d.sport }}'==='hockey'?'#c8102e':'rgba(255,255,255,.7)';x.lineWidth=5;x.beginPath();x.ellipse(cx,(fy+fb)/2,180,70,0,0,2*Math.PI);x.stroke();
  }
  x.restore();
  // light towers + beams
  const towers=[[90,170],[330,90],[750,90],[990,170]];
  x.globalCompositeOperation='lighter';
  towers.forEach(([tx,ty])=>{
    // beam
    g=x.createLinearGradient(tx,ty,cx,fy+300);g.addColorStop(0,'rgba(255,248,220,.35)');g.addColorStop(1,'rgba(255,248,220,0)');
    x.fillStyle=g;x.beginPath();x.moveTo(tx-60,ty);x.lineTo(tx+60,ty);x.lineTo(cx+(tx<cx?150:350),fy+380);x.lineTo(cx-(tx<cx?350:150),fy+380);x.closePath();x.fill();
    // glow
    let rg=x.createRadialGradient(tx,ty,0,tx,ty,220);rg.addColorStop(0,'rgba(255,255,240,.95)');rg.addColorStop(.15,'rgba(255,240,200,.55)');rg.addColorStop(1,'rgba(255,220,150,0)');
    x.fillStyle=rg;x.fillRect(tx-220,ty-220,440,440);
    // bulbs
    for(let r=0;r<4;r++)for(let c=0;c<7;c++){x.fillStyle='rgba(255,255,255,1)';x.beginPath();x.arc(tx-42+c*14,ty-18+r*12,4,0,7);x.fill();}
  });
  // camera flashes
  for(let i=0;i<70;i++){const px=rnd()*W,py=horizon-120+rnd()*520,rr=6+rnd()*22;
    let rg=x.createRadialGradient(px,py,0,px,py,rr);rg.addColorStop(0,'rgba(255,255,255,.9)');rg.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=rg;x.fillRect(px-rr,py-rr,rr*2,rr*2);}
  x.globalCompositeOperation='source-over';
  // haze + team color washes
  g=x.createRadialGradient(cx,fy+150,50,cx,fy+150,700);g.addColorStop(0,'rgba(200,220,255,.18)');g.addColorStop(1,'rgba(200,220,255,0)');x.fillStyle=g;x.fillRect(0,0,W,H);
  g=x.createLinearGradient(0,0,W,0);g.addColorStop(0,hexA("{{ d.away.color }}",.55));g.addColorStop(.42,hexA("{{ d.away.color }}",0));g.addColorStop(.58,hexA("{{ d.home.color }}",0));g.addColorStop(1,hexA("{{ d.home.color }}",.55));
  x.fillStyle=g;x.fillRect(0,0,W,H);
  // film grain
  const id=x.getImageData(0,0,W,H),d=id.data;for(let i=0;i<d.length;i+=4){const n=(rnd()-.5)*14;d[i]+=n;d[i+1]+=n;d[i+2]+=n;}x.putImageData(id,0,0);
}
function hexA(h,a){h=h.replace('#','');const n=parseInt(h,16);return `rgba(${n>>16&255},${n>>8&255},${n&255},${a})`}
{% endblock %}
