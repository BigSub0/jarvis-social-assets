{% extends "base.html.j2" %}
{% from "macros.j2" import mark, wordmark with context %}
{# LOOK: MAGAZINE COVER — Fraunces serif (the website's headline font) + IBM Plex. #}
{% block css %}
body{font-family:Plex,sans-serif;background:
  linear-gradient(160deg,var(--a) 0%,color-mix(in srgb,var(--a) 55%,var(--ink)) 38%,var(--ink) 62%,color-mix(in srgb,var(--b) 60%,var(--ink)) 100%)}
.tex{position:absolute;inset:0;background:radial-gradient(rgba(255,255,255,.05) 1px,transparent 1.5px) 0 0/7px 7px;mix-blend-mode:screen}
.content{position:absolute;inset:0;padding:34px 56px}
.mast{display:flex;align-items:flex-end;justify-content:space-between;border-bottom:3px solid var(--white);padding-bottom:10px}
.mast .t{font-family:Fraunces;font-weight:900;font-size:176px;line-height:.82;letter-spacing:-6px}
.mast .r{text-align:right;font-family:PlexMono;font-weight:600;font-size:19px;letter-spacing:3px;line-height:1.5}
.mast .r b{color:var(--lime)}
.issue{display:flex;justify-content:space-between;align-items:center;margin-top:10px;font-family:PlexMono;font-weight:600;font-size:19px;letter-spacing:3px;opacity:.9}
.kick{margin-top:50px;display:inline-block;font-family:PlexMono;font-weight:700;font-size:22px;letter-spacing:4px;color:var(--ink);background:var(--lime);padding:7px 14px}
h1{margin-top:16px;font-family:Fraunces;font-weight:900;font-size:172px;line-height:.9;letter-spacing:-4px}
h1 .l2{font-family:FrauncesI;font-weight:800;color:var(--lime)}
.dek{margin-top:16px;font-family:Fraunces;font-weight:600;font-size:36px;line-height:1.2;max-width:900px}
.meta{margin-top:12px;font-family:PlexMono;font-weight:600;font-size:21px;letter-spacing:2px;color:var(--cyan)}
.mid{margin-top:44px;display:grid;grid-template-columns:1fr 330px;gap:30px;align-items:start}
.cl{border-top:2px solid rgba(255,255,255,.5)}
.cl .row{padding:19px 0;border-bottom:1px solid rgba(255,255,255,.3);display:grid;grid-template-columns:62px 1fr;gap:6px}
.cl .no{font-family:Fraunces;font-weight:900;font-size:44px;line-height:1;color:var(--lime)}
.cl .h{font-family:Fraunces;font-weight:800;font-size:38px;line-height:1}
.cl .d{font-weight:500;font-size:22px;opacity:.9;margin-top:4px}
.seal{position:relative;width:330px;height:330px;border-radius:50%;background:var(--lime);color:var(--ink);display:flex;flex-direction:column;align-items:center;justify-content:center;
  transform:rotate(-8deg);box-shadow:0 18px 50px rgba(0,0,0,.5);text-align:center;padding:30px}
.seal:before{content:"";position:absolute;inset:12px;border:3px dashed rgba(11,14,20,.55);border-radius:50%}
.seal .k{font-family:PlexMono;font-weight:700;font-size:17px;letter-spacing:3px}
.seal .n{font-family:Fraunces;font-weight:900;font-size:{{ 120 if d.nugget.frac|length<5 else 100 }}px;line-height:.95;letter-spacing:-4px}
.seal .s{font-family:Plex;font-weight:700;font-size:21px;line-height:1.15;max-width:230px}
.nx{margin-top:24px;font-family:Fraunces;font-weight:600;font-size:23px;line-height:1.3;transform:rotate(-2deg)}
.duo{margin-top:48px;display:grid;grid-template-columns:1fr 1fr;border-top:3px solid var(--white)}
.duo>div{padding:18px 22px 0 0}.duo>div+div{padding-left:24px;border-left:1px solid rgba(255,255,255,.4)}
.duo .k{font-family:PlexMono;font-weight:700;font-size:18px;letter-spacing:3px;color:var(--cyan)}
.duo .nm{font-family:Fraunces;font-weight:900;font-size:62px;line-height:.95;margin:6px 0 8px;letter-spacing:-2px}
.duo .st{font-family:Plex;font-weight:700;font-size:34px;color:var(--lime)}
.duo .sb{font-weight:500;font-size:21px;line-height:1.35;opacity:.9;margin-top:4px}
.foot{position:absolute;left:56px;right:56px;bottom:26px;display:grid;grid-template-columns:1fr 150px;gap:24px;align-items:end}
.cta{height:92px;display:flex;align-items:center;justify-content:center;border-radius:60px;background:var(--cyan);color:var(--ink);font-family:Plex;font-weight:700;font-size:38px;letter-spacing:.5px;box-shadow:0 10px 40px rgba(122,222,255,.35)}
.url{margin-top:10px;text-align:center;font-family:Fraunces;font-weight:800;font-size:44px;letter-spacing:1px}
.fine{margin-top:4px;text-align:center;font-weight:500;font-size:14px;opacity:.6}
.bc{height:150px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px}
.bc .bars{width:150px;height:110px;background:repeating-linear-gradient(90deg,var(--white) 0 3px,transparent 3px 6px,var(--white) 6px 7px,transparent 7px 11px,var(--white) 11px 15px,transparent 15px 17px);border:8px solid var(--white);border-width:0 4px}
.bc small{font-family:PlexMono;font-weight:600;font-size:14px;letter-spacing:2px}
{% endblock %}
{% block body %}
<div class="tex"></div>
<div class="content">
  <div class="mast"><div class="t">JARVIS</div><div class="r">SPORTS AI<br><b>{{ b.sheet }}</b><br>ISSUE · {{ d.date }}</div></div>
  <div class="issue"><span>{{ b.tagline|upper }}</span>{{ mark(84) }}</div>
  <div class="kick">{{ d.live }}</div>
  <h1><span class="fit">{{ d.hook[0] }}</span><span class="fit l2">{{ d.hook[1] }}</span></h1>
  <div class="dek fit">{{ d.away.name }} ({{ d.away.rec }}) at {{ d.home.name }} ({{ d.home.rec }})</div>
  <div class="meta fit">{{ d.time_label }} {{ d.time }} · {{ d.network }} · {{ d.venue }}</div>
  <div class="mid">
    <div class="cl">{% for n in d.notes %}<div class="row"><div class="no">0{{ loop.index }}</div><div><div class="h fit">{{ n.e }} {{ n.h }}</div><div class="d">{{ n.d }}</div></div></div>{% endfor %}</div>
    <div><div class="seal"><div class="k">SAFE SHEET</div><div class="n">{{ d.nugget.frac }}</div><div class="s">{{ d.nugget.head }}</div></div>
      <div class="nx">{{ d.nugget.text }}</div></div>
  </div>
  <div class="duo">{% for p in [d.p1,d.p2] %}<div><div class="k">{{ p.t.abbr }} · {{ p.pos }}</div><div class="nm"><span class="fit">{{ p.first }}</span><span class="fit">{{ p.last }}</span></div><div class="st fit">{{ p.stat }}</div><div class="sb">{{ p.sub[0] }} · {{ p.sub[1] }}</div></div>{% endfor %}</div>
</div>
<div class="foot"><div><div class="cta">{{ b.cta }}</div><div class="url">{{ b.url|lower }}</div><div class="fine">{{ b.fine }}</div></div><div class="bc"><div class="bars"></div><small>SUBSCRIBE</small></div></div>
{% endblock %}
