<!doctype html>
<html><head><meta charset="utf-8">
<!-- JARVIS card v3 · look: {{ theme }} · generated by templates/v3/build_card.py — edit the .json, not this file -->
<style>
{{ fonts }}
:root{--a:{{ d.away.color }};--a2:{{ d.away.color2 }};--b:{{ d.home.color }};--b2:{{ d.home.color2 }};
  --ink:{{ b.ink }};--card:{{ b.card }};--line:{{ b.line }};--white:{{ b.white }};--lime:{{ b.lime }};--lime-hi:{{ b.lime_hi }};--lime-lo:{{ b.lime_lo }};--cyan:{{ b.cyan }};--mint:{{ b.mint }};
  --gold:var(--lime);--gold2:var(--lime-lo)}
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:1080px;height:1920px;overflow:hidden}
body{position:relative;background:var(--ink);color:var(--white)}
.fit{white-space:nowrap;overflow:hidden;display:block}
.wm{display:flex;align-items:center;gap:16px;white-space:nowrap}
{% block css %}{% endblock %}
</style></head><body>
{% block body %}{% endblock %}
<script>
// shrink any .fit text until it fits its box (keeps long names/hooks inside the design)
document.fonts.ready.then(()=>{document.querySelectorAll('.fit').forEach(el=>{let s=parseFloat(getComputedStyle(el).fontSize);
  while(el.scrollWidth>el.clientWidth+1&&s>14){s-=2;el.style.fontSize=s+'px';}});});
{% block js %}{% endblock %}
</script>
</body></html>
